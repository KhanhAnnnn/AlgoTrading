# Alpaca Paper Trading Credentials
# Get from: https://app.alpaca.markets -> Paper Trading -> API Keys
ALPACA_KEY_ID=YOUR_ALPACA_PAPER_KEY_HERE
ALPACA_SECRET_KEY=YOUR_ALPACA_PAPER_SECRET_HERE

# Alpaca API Endpoints (do NOT change to live unless intentionally)
ALPACA_NEWS_BASE_URL=https://data.alpaca.markets
ALPACA_TRADE_BASE_URL=https://paper-api.alpaca.markets

# Redpanda brokers (host-accessible ports)
REDPANDA_BROKERS=localhost:9092,localhost:9093

# Slack credentials
# Bot Token: from https://api.slack.com/apps -> your app -> OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-YOUR-SLACK-BOT-TOKEN-HERE
SLACK_CHANNEL_ID=YOUR-CHANNEL-ID-HERE

# Trading mode: DRY_RUN (default, safe) or PAPER_TRADING
TRADING_MODE=DRY_RUN
