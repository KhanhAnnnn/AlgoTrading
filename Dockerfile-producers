FROM python:3.12-slim

WORKDIR /app

# Install system dependencies if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
RUN pip install --no-cache-dir \
    "kafka-python>=2.0.2" \
    "alpaca-py>=0.40.0" \
    "nltk>=3.9" \
    "requests>=2.31.0" \
    "psutil>=5.9.0" \
    "python-dotenv>=1.0.0"

# Pre-download NLTK VADER lexicon
RUN python -c "import nltk; nltk.download('vader_lexicon', download_dir='/usr/local/share/nltk_data')"

COPY libs/ /app/libs/
COPY continuous_price_producer.py /app/continuous_price_producer.py
COPY continuous_news_producer.py /app/continuous_news_producer.py

# Default entrypoint placeholder
CMD ["python", "continuous_price_producer.py"]
